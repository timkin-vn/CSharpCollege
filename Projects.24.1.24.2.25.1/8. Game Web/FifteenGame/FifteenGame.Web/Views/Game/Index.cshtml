@model FifteenGame.Web.Models.GameViewModel

@{
    ViewBag.Title = "Крестики-нолики";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Крестики-нолики</title>
    <style>
        body {
            font-family: Arial;
            text-align: center;
            background-color: #f4f4f4;
        }

        .board {
            display: inline-grid;
            grid-template-columns: repeat(3, 100px);
            gap: 5px;
            margin-top: 20px;
        }

        .cell button {
            width: 100px;
            height: 100px;
            font-size: 40px;
            font-weight: bold;
            cursor: pointer;
            background: white;
            border: 2px solid #333;
        }

        .status {
            font-size: 24px;
            margin-bottom: 20px;
            margin-top: 20px;
        }

        .reset-btn {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <h1>Крестики-нолики</h1>

    <div class="status">@Model.Status</div>

    <div class="board">
        @foreach (var cell in Model.Cells)
        {
            <div class="cell">
                @using (Html.BeginForm("Move", "Game", FormMethod.Post))
                {
                    <input type="hidden" name="row" value="@cell.Row" />
                    <input type="hidden" name="col" value="@cell.Col" />
                    <button type="submit">@cell.Text</button>
                }
            </div>
        }
    </div>

    @using (Html.BeginForm("NewGame", "Game", FormMethod.Post))
    {
        <button type="submit" class="reset-btn">Новая игра</button>
    }
</body>
</html>