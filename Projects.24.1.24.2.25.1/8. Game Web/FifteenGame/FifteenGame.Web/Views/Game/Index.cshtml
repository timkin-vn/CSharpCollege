
@model FifteenGame.Web.Models.GameViewModel

@{
    ViewBag.Title = "2048";
}

<main class="game-page">
    <div class="game-container">
        <header class="game-header">
            <div class="game-logo">2048</div>

            <div class="score-container">
                <div class="score-box">
                    <span>СЧЁТ</span>
                    <strong>@Model.Score</strong>
                </div>
                <div class="score-box">
                    <span>РЕКОРД</span>
                    <strong>@Model.BestScore</strong>
                </div>
            </div>
        </header>

        <div class="game-toolbar">
            <div>
                <h1>Игра 2048</h1>
                <p>Объединяй плитки и получи 2048!</p>
            </div>

            @using (Html.BeginForm("NewGame", "Game", FormMethod.Post))
            {
                <button type="submit" class="game-button new-game-button">
                    Новая игра
                </button>
            }
        </div>

        @if (Model.HasWon)
        {
            <div class="game-message win-message">
                Поздравляем! Ты собрал плитку 2048.
            </div>
        }

        @if (Model.IsGameOver)
        {
            <div class="game-message over-message">
                Игра окончена. Попробуй ещё раз!
            </div>
        }

        <div class="board" id="gameBoard">
            @for (int row = 0; row < Model.RowCount; row++)
            {
                for (int column = 0; column < Model.ColumnCount; column++)
                {
                    var cell = Model.Cells[row, column];

                    <div class="@cell.CssClass">
                        @cell.Text
                    </div>
                }
            }
        </div>

        <div class="game-actions">
            @using (Html.BeginForm("Undo", "Game", FormMethod.Post))
            {
                <button type="submit"
                        class="game-button undo-button"
                        @(Model.CanUndo ? "" : "disabled")>
                    Отменить ход
                </button>
            }

        <div class="move-controls">
                @using (Html.BeginForm("MakeMove", "Game", FormMethod.Post))
                {
                    <button type="submit" name="directionText" value="Up">↑</button>
                }

        <div class="horizontal-controls">
                @using (Html.BeginForm("MakeMove", "Game", FormMethod.Post))
                {
                    <button type="submit" name="directionText" value="Left">←</button>
                }

                @using (Html.BeginForm("MakeMove", "Game", FormMethod.Post))
                {
                    <button type="submit" name="directionText" value="Down">↓</button>
                }

                @using (Html.BeginForm("MakeMove", "Game", FormMethod.Post))
                {
                    <button type="submit" name="directionText" value="Right">→</button>
                }
        </div>
        </div>
        </div>

        <section class="game-instructions">
            <h2>Как играть</h2>
            <p>Используй стрелки на клавиатуре, кнопки на экране или свайпы на телефоне. Одинаковые плитки объединяются в одну, а их значения складываются.</p>
        </section>
    </div>
</main>

@section scripts {
    <script>
        (function () {
            var board = document.getElementById("gameBoard");
            var startX = 0;
            var startY = 0;
            var locked = @((Model.IsGameOver).ToString().ToLowerInvariant());

            document.addEventListener("keydown", function (event) {
                if (locked || event.altKey || event.ctrlKey || event.metaKey) {
                    return;
                }

                var directions = {
                    ArrowLeft: "Left",
                    ArrowRight: "Right",
                    ArrowUp: "Up",
                    ArrowDown: "Down"
                };

                var direction = directions[event.key];

                if (!direction) {
                    return;
                }

                event.preventDefault();

                var buttons = document.querySelectorAll(
                    'button[name="directionText"]'
                );

                for (var i = 0; i < buttons.length; i++) {
                    if (buttons[i].value === direction) {
                        buttons[i].click();
                        break;
                    }
                }
            });

            board.addEventListener("touchstart", function (event) {
                if (!event.changedTouches.length) {
                    return;
                }

                startX = event.changedTouches[0].clientX;
                startY = event.changedTouches[0].clientY;
            }, { passive: true });

            board.addEventListener("touchend", function (event) {
                if (locked || !event.changedTouches.length) {
                    return;
                }

                var deltaX = event.changedTouches[0].clientX - startX;
                var deltaY = event.changedTouches[0].clientY - startY;

                if (Math.max(Math.abs(deltaX), Math.abs(deltaY)) < 25) {
                    return;
                }

                var direction;

                if (Math.abs(deltaX) > Math.abs(deltaY)) {
                    direction = deltaX > 0 ? "Right" : "Left";
                } else {
                    direction = deltaY > 0 ? "Down" : "Up";
                }

                var buttons = document.querySelectorAll(
                    'button[name="directionText"]'
                );

                for (var i = 0; i < buttons.length; i++) {
                    if (buttons[i].value === direction) {
                        buttons[i].form.submit();
                        break;
                    }
                }
            }, { passive: true });
        })();
    </script>
}
