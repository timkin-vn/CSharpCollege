@model FifteenGame.Web.Models.GameViewModel

@{
    ViewBag.Title = "Морской Бой 15";
    bool isGameOver = (bool?)ViewBag.IsGameOver ?? false;
}

<main>
    <h2>Морской Бой</h2>

    @if (isGameOver)
    {
        <h2 class="text-danger">Все корабли уничтожены! Игра завершена.</h2>
        <div>
            @Html.ActionLink("Повторить", "Index", new { }, new { @class = "btn btn-success" })
        </div>
    }

    <div class="container mt-4">
        @for (int row = 0; row < Model.RowCount; row++)
        {
            <div class="row justify-content-center m-0">
                @for (int column = 0; column < Model.ColumnCount; column++)
                {
                    var cell = Model.Cells[row, column];

                    if (isGameOver || (cell.Direction != FifteenGame.Business.Models.MoveDirection.Empty && cell.Direction != FifteenGame.Business.Models.MoveDirection.Ship))
                    {
                        <div class="col-1 p-1 text-center">
                            <div class="grid-cell @cell.CssClass" style="width: 45px; height: 45px; line-height: 45px; margin: auto; font-size: 20px; font-weight: bold; border: 1px solid #ccc;">
                                @cell.Symbol
                            </div>
                        </div>
                        continue;
                    }

                    <div class="col-1 p-1 text-center">
                        <a href="@Url.Action("MakeMove", "Game", new { row = row, column = column })" style="text-decoration: none;">
                            <div class="grid-cell @cell.CssClass"
                                 style="width: 45px; height: 45px; margin: auto; border: 1px solid #ccc; background-color: #add8e6; cursor: pointer;"
                                 title="Выстрел в строку @row, колонку @column">
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</main>
