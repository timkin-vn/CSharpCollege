
@model FifteenGame.Web.Models.GameViewModel

@{
    ViewBag.Title = "Игра 15";
    bool isGameOver = (bool?)ViewBag.IsGameOver ?? false;
}

<style>
    .game-page {
        max-width: 760px;
        margin: 25px auto;
        padding: 24px;
        text-align: center;
        background: #f5f0e6;
        border-radius: 16px;
    }

    .game-board {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
        max-width: 560px;
        margin: 24px auto;
        padding: 10px;
        background: #b9a58d;
        border: 2px solid #806b56;
        border-radius: 12px;
    }

    .game-cell {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1;
        min-width: 0;
        overflow: hidden;
        background: #e8d4b5;
        border: 1px solid #8d7053;
        border-radius: 7px;
    }

        .game-cell a,
        .game-cell img {
            display: block;
            width: 100%;
            height: 100%;
        }

        .game-cell img {
            object-fit: contain;
        }

        .game-cell.empty {
            background: #b9a58d;
            border-color: transparent;
        }

    .game-info {
        margin: 16px 0;
        font-size: 18px;
        color: #49382d;
    }

    .game-actions {
        margin-top: 20px;
    }

        .game-actions a {
            margin: 5px;
        }
</style>

<main class="game-page">
    <h2>Пятнашки</h2>

    <div class="game-info">
        Ходов: <strong>@Model.MoveCount</strong>
    </div>

    @if (isGameOver)
    {
        <div class="alert alert-success">
            Поздравляем! Вы собрали все плитки!
            <br />
            Количество ходов: <strong>@Model.MoveCount</strong>
        </div>
    }

    <div class="game-board">
        @for (int row = 0; row < Model.RowCount; row++)
        {
            for (int column = 0; column < Model.ColumnCount; column++)
            {
                var cell = Model.Cells[row, column];

                if (cell.IsEmpty)
                {
                    <div class="game-cell empty"></div>
                    continue;
                }

                <div class="game-cell">
                    @if (!isGameOver &&
                         cell.Direction != FifteenGame.Business.Models.MoveDirection.None)
                    {
                        <a href="@Url.Action(
                            "MakeMove",
                            "Game",
                            new { directionText = cell.DirectionText })"
                           title="Переместить плитку @cell.Text">
                            <img src="@Url.Content(
                                "~/Content/img/" + cell.Text + ".png")"
                                 alt="Плитка @cell.Text" />
                        </a>
                    }
                    else
                    {
                        <img src="@Url.Content(
                            "~/Content/img/" + cell.Text + ".png")"
                             alt="Плитка @cell.Text" />
                    }
                </div>
            }
        }
    </div>


    <div class="game-actions">
        <button type="button"
                class="btn btn-secondary"
                onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '@Url.Action("Index", "Home")'; }">
            ← Назад
        </button>

        @Html.ActionLink(
            "Начать заново",
            "Restart",
            "Game",
            null,
            new { @class = "btn btn-success" })
    </div>

</main>
