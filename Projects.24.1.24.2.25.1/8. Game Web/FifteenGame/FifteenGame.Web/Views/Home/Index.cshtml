@model FifteenGame.Core.BusinessLogic.Services.GameService

@{
    ViewBag.Title = "Ключи и монстры";
}

<h1>Ключи и монстры</h1>

<div id="game">
    @Html.Partial("_GameGrid", Model)
</div>

<p class="controls">Управление: стрелки или WASD, R — заново</p>

@section scripts {
    <script>
        var keyMap = {
            ArrowUp: [-1, 0], KeyW: [-1, 0],
            ArrowDown: [1, 0], KeyS: [1, 0],
            ArrowLeft: [0, -1], KeyA: [0, -1],
            ArrowRight: [0, 1], KeyD: [0, 1]
        };

        function send(url, data) {
            var body = new URLSearchParams(data || {});
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body,
                credentials: 'same-origin'
            })
                .then(function (r) { return r.text(); })
                .then(function (html) { document.getElementById('game').innerHTML = html; });
        }

        function restartGame() {
            send('@Url.Action("Restart", "Home")');
        }

        document.addEventListener('keydown', function (e) {
            if (e.code === 'KeyR') {
                restartGame();
                return;
            }

            var move = keyMap[e.code];
            if (!move) return;

            e.preventDefault();
            send('@Url.Action("Move", "Home")', { dRow: move[0], dColumn: move[1] });
        });
    </script>
}
