@using FifteenGame.Core.BusinessLogic.Models
@using FifteenGame.Core.BusinessLogic.Services
@model GameService

<div class="info-bar">
    <span>Ключи: @(GameService.KeyCount - Model.KeysLeft) / @GameService.KeyCount</span>
    <span>Ходов: @Model.Moves</span>
    <button type="button" onclick="restartGame()">Заново (R)</button>
</div>

<div class="board-wrap">
    <div class="board" style="grid-template-columns: repeat(@GameService.Size, 1fr);">
        @for (int row = 0; row < GameService.Size; row++)
        {
            for (int column = 0; column < GameService.Size; column++)
            {
                string css = "cell floor";

                if (row == Model.PlayerRow && column == Model.PlayerColumn)
                {
                    css = "cell player";
                }
                else if (Model.Monsters.Exists(m => m.Row == row && m.Column == column))
                {
                    css = "cell monster";
                }
                else
                {
                    switch (Model.Cells[row, column])
                    {
                        case CellType.Wall:
                            css = "cell wall";
                            break;
                        case CellType.Key:
                            css = "cell key";
                            break;
                        case CellType.Exit:
                            css = Model.KeysLeft == 0 ? "cell exit-open" : "cell exit-closed";
                            break;
                    }
                }
                <div class="@css"></div>
            }
        }
    </div>

    @if (Model.State != GameState.Playing)
    {
        <div class="overlay">
            <div class="result">
                @if (Model.State == GameState.Won)
                {
                    <div>Победа!</div>
                    <small>Ходов: @Model.Moves</small>
                }
                else
                {
                    <div>Вас поймал монстр</div>
                }
                <button type="button" onclick="restartGame()">Играть снова</button>
            </div>
        </div>
    }
</div>

<p class="hint">
    @(Model.KeysLeft > 0 ? "Соберите все ключи — выход откроется" : "Все ключи собраны — бегите к выходу!")
</p>
