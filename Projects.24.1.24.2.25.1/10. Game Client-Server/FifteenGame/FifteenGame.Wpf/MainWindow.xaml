<Window x:Class="FifteenGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:FifteenGame.Wpf.ViewModels"
        Title="2048"
        Width="620"
        Height="800"
        MinWidth="540"
        MinHeight="700"
        Background="#171717"
        Foreground="#F9F6F2"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        Focusable="True">

    <Window.Resources>
        <Style x:Key="GameButton" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#8F7A66"/>
            <Setter Property="Foreground" Value="#F9F6F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CounterStyle" TargetType="Border">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="2048"
                           FontSize="54"
                           FontWeight="Bold"
                           Foreground="#F9F6F2"/>
                <TextBlock Text="Объединяй плитки и набирай очки"
                           FontSize="12"
                           Foreground="#B5ADA4"
                           Margin="2,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Style="{StaticResource CounterStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="СЧЁТ"
                                   FontSize="11"
                                   Foreground="#C5BDB4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Score}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CounterStyle}">
                    <StackPanel>
                        <TextBlock Text="РЕКОРД"
                                   FontSize="11"
                                   Foreground="#C5BDB4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BestScore}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding UserName, StringFormat=Игрок: {0}}"
                       VerticalAlignment="Center"
                       Foreground="#C5BDB4"
                       FontSize="14"/>

            <Border Grid.Column="1"
                    Background="#3A3A3A"
                    CornerRadius="5"
                    Padding="12,7">
                <TextBlock Text="{Binding MoveCount, StringFormat=Ходы: {0}}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border Background="#BBADA0"
                    CornerRadius="8"
                    Padding="6"
                    Width="360"
                    Height="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"> 
                <ItemsControl ItemsSource="{Binding Cells}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="4" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" CornerRadius="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#D8CCBF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value}" Value="2">
                                                <Setter Property="Background" Value="#EEE4DA"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="4">
                                                <Setter Property="Background" Value="#EDE0C8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="8">
                                                <Setter Property="Background" Value="#F2B179"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="16">
                                                <Setter Property="Background" Value="#F59563"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="32">
                                                <Setter Property="Background" Value="#F67C5F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="64">
                                                <Setter Property="Background" Value="#F65E3B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="128">
                                                <Setter Property="Background" Value="#EDCF72"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="256">
                                                <Setter Property="Background" Value="#EDCC61"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="512">
                                                <Setter Property="Background" Value="#EDC850"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="1024">
                                                <Setter Property="Background" Value="#EDC53F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="2048">
                                                <Setter Property="Background" Value="#EDC22E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding Text}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#776E65"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#776E65"/>
                                            <Setter Property="FontSize" Value="28"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Value}" Value="8">
                                                    <Setter Property="Foreground" Value="#F9F6F2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="16">
                                                    <Setter Property="Foreground" Value="#F9F6F2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="32">
                                                    <Setter Property="Foreground" Value="#F9F6F2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="64">
                                                    <Setter Property="Foreground" Value="#F9F6F2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="128">
                                                    <Setter Property="FontSize" Value="24"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="256">
                                                    <Setter Property="FontSize" Value="24"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="512">
                                                    <Setter Property="FontSize" Value="24"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="1024">
                                                    <Setter Property="FontSize" Value="20"/>
                                                    <Setter Property="Foreground" Value="#F9F6F2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="2048">
                                                    <Setter Property="FontSize" Value="20"/>
                                                    <Setter Property="Foreground" Value="#F9F6F2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button Content="Новая игра"
                    Click="NewGame_Click"
                    Width="160"
                    Height="38"
                    Margin="4,0,4,6"
                    Style="{StaticResource GameButton}"/>

            <UniformGrid Rows="2"
                         Columns="3"
                         HorizontalAlignment="Center">
                <Border Width="54" Height="40"/>
                <Button Content="↑"
                        Width="54"
                        Height="40"
                        Click="Up_Click"
                        Style="{StaticResource GameButton}"/>
                <Border Width="54" Height="40"/>

                <Button Content="←"
                        Width="54"
                        Height="40"
                        Click="Left_Click"
                        Style="{StaticResource GameButton}"/>
                <Button Content="↓"
                        Width="54"
                        Height="40"
                        Click="Down_Click"
                        Style="{StaticResource GameButton}"/>
                <Button Content="→"
                        Width="54"
                        Height="40"
                        Click="Right_Click"
                        Style="{StaticResource GameButton}"/>
            </UniformGrid>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Text="Используй стрелки или W A S D, чтобы объединять плитки."
                   Foreground="#91877D"
                   FontSize="12"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
    </Grid>
</Window>