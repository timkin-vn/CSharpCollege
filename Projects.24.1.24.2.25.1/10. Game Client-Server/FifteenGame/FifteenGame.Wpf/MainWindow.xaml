<Window x:Class="FifteenGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FifteenGame.Wpf.ViewModels"
        Title="Ключи и монстры" Height="720" Width="620"
        MinHeight="500" MinWidth="460"
        Background="#1A1A1F" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Up" Command="{Binding MoveUpCommand}"/>
        <KeyBinding Key="W" Command="{Binding MoveUpCommand}"/>
        <KeyBinding Key="Down" Command="{Binding MoveDownCommand}"/>
        <KeyBinding Key="S" Command="{Binding MoveDownCommand}"/>
        <KeyBinding Key="Left" Command="{Binding MoveLeftCommand}"/>
        <KeyBinding Key="A" Command="{Binding MoveLeftCommand}"/>
        <KeyBinding Key="Right" Command="{Binding MoveRightCommand}"/>
        <KeyBinding Key="D" Command="{Binding MoveRightCommand}"/>
        <KeyBinding Key="R" Command="{Binding RestartCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#26262E" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Заново (R)" Command="{Binding RestartCommand}"
                        Focusable="False" Padding="14,6" Foreground="White" Background="#3A7BD5"
                        BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="{Binding UserName}" Style="{StaticResource InfoText}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding KeysText}" Style="{StaticResource InfoText}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding MovesText}" Style="{StaticResource InfoText}"/>
            </DockPanel>
        </Border>

        <!-- Игровое поле -->
        <Grid Grid.Row="1">
            <Viewbox>
                <Border Background="#0F0F14" CornerRadius="6" Padding="4">
                    <ItemsControl ItemsSource="{Binding Cells}" Width="528" Height="528">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="12" Columns="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Image}" Margin="1" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Viewbox>

            <!-- Результат игры -->
            <Border Background="#CC000000" CornerRadius="6"
                    Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ResultText}" Foreground="White" FontSize="32"
                               FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="Играть снова" Command="{Binding RestartCommand}" Focusable="False"
                            Padding="20,8" FontSize="16" Foreground="White" Background="#3A7BD5"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Подсказка -->
        <TextBlock Grid.Row="2" Text="{Binding Hint}" Foreground="#AAAAAA" FontSize="14"
                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
</Window>
