<Window x:Class="Minesweeper.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper.Wpf"
        xmlns:viewmodels="clr-namespace:Minesweeper.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Сапёр" Height="535" Width="460" MinHeight="535" MinWidth="460"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="САПЁР" FontSize="25" FontWeight="Bold" Foreground="#172554" />
                <TextBlock Text="Найдите безопасные клетки" FontSize="12" Foreground="#64748B" />
            </StackPanel>
            <Button Content="Новая игра" DockPanel.Dock="Right" Click="NewGame_Click"
                    Padding="12,7" Margin="8,3,0,0" VerticalAlignment="Center"
                    Background="#2563EB" Foreground="White" BorderThickness="0" />
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💣 Осталось мин: " Foreground="#334155" />
                    <TextBlock Text="{Binding MinesLeft}" FontWeight="Bold" Foreground="#DC2626" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Ходы: " Foreground="#334155" />
                    <TextBlock Text="{Binding Moves}" FontWeight="Bold" Foreground="#1D4ED8" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#CBD5E1" CornerRadius="8" Padding="5"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="10" Columns="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="36" Height="36" Margin="1" Padding="0"
                                Content="{Binding Text}" FontSize="16" FontWeight="Bold"
                                Tag="{Binding}" Click="Cell_Click"
                                PreviewMouseRightButtonDown="Cell_RightClick"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#94A3B8" />
                                    <Setter Property="Foreground" Value="#1E293B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRevealed}" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                            <Setter Property="Background" Value="#FDE68A" />
                                            <Setter Property="Foreground" Value="#B45309" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0"
                   TextWrapping="Wrap" TextAlignment="Center" Foreground="#334155" />
    </Grid>
</Window>
