<Window x:Class="FifteenGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:FifteenGame.Wpf.ViewModels"
        Title="Сапёр WPF" SizeToContent="WidthAndHeight" MinWidth="590"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="CellButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="#F2F2F2">
        <Border DockPanel.Dock="Top" Margin="10" Padding="10" MinWidth="560" Background="White"
                BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Сапёр" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="ЛКМ — открыть клетку, ПКМ — поставить или убрать флажок"
                           Margin="0,4,0,8" HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Сложность:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <ComboBox x:Name="DifficultyComboBox" Width="185" SelectedIndex="0"
                              SelectionChanged="Options_SelectionChanged">
                        <ComboBoxItem Content="Лёгкий — 9×9, 10 мин" />
                        <ComboBoxItem Content="Средний — 12×12, 25 мин" />
                        <ComboBoxItem Content="Тяжёлый — 16×16, 50 мин" />
                    </ComboBox>
                    <TextBlock Text="Первый ход:" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="16,0,8,0" />
                    <ComboBox x:Name="FirstMoveComboBox" Width="130" SelectedIndex="0"
                              SelectionChanged="Options_SelectionChanged">
                        <ComboBoxItem Content="Безопасный" />
                        <ComboBoxItem Content="Опасный" />
                    </ComboBox>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding MinesInfo}" VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="Новая игра" Padding="12,6" Click="NewGameButton_Click" />
                    <TextBlock Grid.Column="2" Text="{Binding OpenedInfo}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold" />
                </Grid>
                <TextBlock Text="{Binding Status}" Margin="0,8,0,0" FontSize="15"
                           FontWeight="SemiBold" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Margin="10,0,10,10" Padding="8" Background="White" BorderBrush="#CCCCCC"
                BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Cells}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CellButtonStyle}"
                                Width="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Height="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Content="{Binding Text}" Background="{Binding Background}"
                                Foreground="{Binding Foreground}" BorderBrush="{Binding BorderBrush}"
                                IsEnabled="{Binding IsEnabled}" Click="Cell_LeftClick"
                                PreviewMouseRightButtonUp="Cell_RightClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DockPanel>
</Window>
