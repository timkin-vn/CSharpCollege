<Window x:Class="Calculator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Calculator.Wpf.ViewModels"
        Title="Калькулятор" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="FontSize" Value="37" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Background" Value="#FFF0F0F0" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#FFB0B0B0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Canvas Width="646" Height="422" Background="#FFF0F0F0">
        <Border Canvas.Left="12" Canvas.Top="9" Width="622" Height="81" Background="Black">
            <TextBlock Text="{Binding Result}" Foreground="LimeGreen" FontSize="48"
                       FontFamily="Segoe UI" TextAlignment="Right" VerticalAlignment="Center"
                       Margin="8,0,8,0" TextTrimming="CharacterEllipsis" />
        </Border>
        <Button Canvas.Left="13" Canvas.Top="140" Width="107" Height="63" Content="7" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="239" Canvas.Top="278" Width="107" Height="63" Content="3" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="239" Canvas.Top="209" Width="107" Height="63" Content="6" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="13" Canvas.Top="347" Width="107" Height="63" Content="0" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="126" Canvas.Top="278" Width="107" Height="63" Content="2" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="12" Canvas.Top="278" Width="107" Height="63" Content="1" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="126" Canvas.Top="209" Width="107" Height="63" Content="5" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="12" Canvas.Top="209" Width="107" Height="63" Content="4" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="239" Canvas.Top="140" Width="107" Height="63" Content="9" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="126" Canvas.Top="140" Width="107" Height="63" Content="8" Click="DigitButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="414" Canvas.Top="140" Width="220" Height="63" Content="C" Click="ClearButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="414" Canvas.Top="278" Width="107" Height="63" Content="*" Click="OperationButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="527" Canvas.Top="278" Width="107" Height="63" Content="/" Click="OperationButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="414" Canvas.Top="209" Width="107" Height="63" Content="+" Click="OperationButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="527" Canvas.Top="209" Width="107" Height="63" Content="-" Click="OperationButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="414" Canvas.Top="347" Width="220" Height="63" Content="=" Click="EqualButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="126" Canvas.Top="347" Width="107" Height="63" Content="," Click="CommaButton_Click" Style="{StaticResource CalcButton}" />
        <Button Canvas.Left="239" Canvas.Top="347" Width="107" Height="63" Content="x^2" Click="SquareButton_Click" Style="{StaticResource CalcButton}" />
    </Canvas>
</Window>
