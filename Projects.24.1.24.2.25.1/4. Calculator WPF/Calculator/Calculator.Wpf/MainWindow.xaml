<Window x:Class="Calculator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Calculator.Wpf.ViewModels"
        Title="Расширенный калькулятор"
        Height="600" Width="850"
        MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="{Binding Expression}"
                   FontSize="20"
                   Foreground="Gray"
                   TextAlignment="Right"
                   TextTrimming="CharacterEllipsis"
                   Margin="5"/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                   Text="{Binding Result}"
                   FontSize="36"
                   FontWeight="Bold"
                   TextAlignment="Right"
                   VerticalAlignment="Center"
                   Background="Black"
                   Foreground="LightGoldenrodYellow"
                   Padding="12"
                   Margin="5,5,5,12"/>

        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                <TextBlock Text="{Binding MemoryValue}"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="5"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="MC" Click="MemoryClearButton_Click"
                            Padding="10,5" Margin="2"/>
                    <Button Content="MR" Click="MemoryRecallButton_Click"
                            Padding="10,5" Margin="2"/>
                    <Button Content="M+" Click="MemoryAddButton_Click"
                            Padding="10,5" Margin="2"/>
                </StackPanel>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="4" Rows="5">
                <Button Style="{StaticResource CalcButton}" Content="(" Tag="(" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content=")" Tag=")" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="C" Click="ClearButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="/" Tag="/" Click="InputButton_Click"/>

                <Button Style="{StaticResource CalcButton}" Content="7" Tag="7" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="8" Tag="8" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="9" Tag="9" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="*" Tag="*" Click="InputButton_Click"/>

                <Button Style="{StaticResource CalcButton}" Content="4" Tag="4" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="5" Tag="5" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="6" Tag="6" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="-" Tag="-" Click="InputButton_Click"/>

                <Button Style="{StaticResource CalcButton}" Content="1" Tag="1" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="2" Tag="2" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="3" Tag="3" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="+" Tag="+" Click="InputButton_Click"/>

                <Button Style="{StaticResource CalcButton}" Content="±" Tag="-" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="0" Tag="0" Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="." Tag="." Click="InputButton_Click"/>
                <Button Style="{StaticResource CalcButton}" Content="=" Click="EqualButton_Click"/>
            </UniformGrid>
        </Grid>

        <GroupBox Grid.Row="2" Grid.Column="1" Header="История вычислений">
            <DockPanel Margin="5">
                <Button DockPanel.Dock="Bottom"
                        Content="Очистить историю"
                        Padding="8"
                        Margin="0,8,0,0"
                        Click="ClearHistoryButton_Click"/>

                <ListBox ItemsSource="{Binding History}"
                         FontSize="15"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
