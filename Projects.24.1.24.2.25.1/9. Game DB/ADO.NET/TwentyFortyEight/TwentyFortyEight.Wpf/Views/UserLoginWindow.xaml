<Window x:Class="TwentyFortyEight.Wpf.Views.UserLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:TwentyFortyEight.Wpf.ViewModels"
        Title="Регистрация участника"
        Height="220" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        ResizeMode="NoResize"
        FontFamily="Consolas">

    <Window.DataContext>
        <viewmodels:UserLoginWindowViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="ИДЕНТИФИКАТОР ИГРОКА:"
                   FontSize="14"
                   Foreground="#66FCF1"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" 
                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="16"
                 Padding="8"
                 Background="#1F2833"
                 Foreground="#FFFFFF"
                 CaretBrush="#66FCF1"
                 BorderBrush="#45A29E"
                 BorderThickness="2"
                 Margin="0,0,0,10"
                 KeyDown="TextBox_KeyDown">
            <TextBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <TextBlock Grid.Row="2" 
                   Text="Профиль будет создан автоматически при его отсутствии"
                   FontSize="11"
                   FontStyle="Italic"
                   Foreground="#45A29E"
                   Margin="2,0,0,0"/>

        <Button Grid.Row="3" 
                Content="[ ЗАПУСТИТЬ СЕССИЮ ]"
                Click="OkButton_Click"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#1F2833"/>
                    <Setter Property="Foreground" Value="#66FCF1"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#45A29E"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#45A29E"/>
                            <Setter Property="Foreground" Value="#0B0C10"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>