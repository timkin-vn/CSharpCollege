<Window x:Class="TwentyFortyEight.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:TwentyFortyEight.Wpf.ViewModels"
        Title="2048 Neon"
        Height="720"
        Width="620"
        MinWidth="460"
        MinHeight="560"
        Background="#0B0C10"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        FontFamily="Consolas">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="2048"
                       FontSize="52"
                       FontFamily="Impact"
                       Foreground="#66FCF1"
                       VerticalAlignment="Center"/>

            <!-- Упрощенная кнопка без сложного шаблона -->
            <Button Grid.Column="1"
                    Content="[ NEW GAME ]"
                    Click="NewGameButton_Click"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Background="#1F2833"
                    Foreground="#66FCF1"
                    BorderBrush="#45A29E"
                    BorderThickness="2"
                    FontSize="14"
                    FontWeight="Bold"
                    Padding="16,10">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Панель с именем пользователя -->
        <Border Grid.Row="1" Background="#1F2833" BorderBrush="#45A29E" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Текущий сеанс: " FontSize="14" Foreground="#66FCF1"/>
                <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="Bold" Foreground="#FF007F"/>
            </StackPanel>
        </Border>

        <!-- Игровое поле -->
        <Border Grid.Row="2"
                Background="#1F2833"
                BorderBrush="#45A29E"
                BorderThickness="2"
                CornerRadius="15"
                Padding="12">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="4" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6"
                                CornerRadius="12"
                                BorderBrush="#66FCF1"
                                BorderThickness="1"
                                Background="{Binding Background}">
                            <TextBlock Text="{Binding Text}"
                                       FontSize="36"
                                       FontFamily="Consolas"
                                       FontWeight="Bold"
                                       Foreground="{Binding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Нижние панели с очками -->
        <UniformGrid Grid.Row="3" Columns="2" Margin="0,15,0,5">
            <Border Background="#1F2833" BorderBrush="#FF007F" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="НАБРАНО ОЧКОВ" Foreground="#66FCF1" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Score}" Foreground="#FF007F" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#1F2833" BorderBrush="#BB86FC" BorderThickness="1" CornerRadius="8" Padding="10" Margin="8,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ЛУЧШИЙ РЕЗУЛЬТАТ" Foreground="#66FCF1" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="{Binding BestTile}" Foreground="#BB86FC" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="4"
                   Text="Управление: стрелки или WASD"
                   FontSize="12" Foreground="#45A29E"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</Window>