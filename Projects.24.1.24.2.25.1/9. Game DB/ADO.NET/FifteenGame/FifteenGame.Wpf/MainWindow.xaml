<Window x:Class="FifteenGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:FifteenGame.Wpf.ViewModels"
        Title="2048"
        Height="825"
        Width="620"
        MinHeight="825"
        MinWidth="580"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        Focusable="True">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="GameButton" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#8F7A66"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FAF8EF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="24,18,24,8">
            <TextBlock Text="2048"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#776E65"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Border Background="#BBADA0"
                        CornerRadius="5"
                        Padding="14,6"
                        Margin="4">
                    <StackPanel>
                        <TextBlock Text="СЧЁТ"
                                   Foreground="#EEE4DA"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Score}"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#BBADA0"
                        CornerRadius="5"
                        Padding="14,6"
                        Margin="4">
                    <StackPanel>
                        <TextBlock Text="РЕКОРД"
                                   Foreground="#EEE4DA"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BestScore}"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="24,4,24,8">
            <TextBlock Text="{Binding UserName, StringFormat=Игрок: {0}}"
                       FontSize="15"
                       Foreground="#776E65"/>
            <TextBlock Text="{Binding MoveCount, StringFormat=Ходов: {0}}"
                       FontSize="15"
                       Foreground="#776E65"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,12">
            <Button Content="Новая игра"
                    Style="{StaticResource GameButton}"
                    Click="NewGame_Click"/>
        </StackPanel>

        <Border Grid.Row="3"
                Width="420"
                Height="420"
                Background="#BBADA0"
                CornerRadius="7"
                Padding="8"
                HorizontalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Grid.Row" Value="{Binding Row}"/>
                        <Setter Property="Grid.Column" Value="{Binding Column}"/>
                        <Setter Property="Margin" Value="4"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Background}"
                                CornerRadius="5">
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{Binding Foreground}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center">
            <TextBlock Text="Управление стрелками клавиатуры"
                       Foreground="#776E65"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <UniformGrid Rows="2"
                         Columns="3"
                         HorizontalAlignment="Center">
                <Border Background="Transparent"/>

                <Button Content="↑"
                        Style="{StaticResource GameButton}"
                        Click="Up_Click"
                        MinWidth="64"/>

                <Border Background="Transparent"/>

                <Button Content="←"
                        Style="{StaticResource GameButton}"
                        Click="Left_Click"
                        MinWidth="64"/>

                <Button Content="↓"
                        Style="{StaticResource GameButton}"
                        Click="Down_Click"
                        MinWidth="64"/>

                <Button Content="→"
                        Style="{StaticResource GameButton}"
                        Click="Right_Click"
                        MinWidth="64"/>
            </UniformGrid>
        </StackPanel>

        <TextBlock Grid.Row="5"
                   Text="Объединяй одинаковые плитки, чтобы получить 2048."
                   Foreground="#776E65"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="12,12,12,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>