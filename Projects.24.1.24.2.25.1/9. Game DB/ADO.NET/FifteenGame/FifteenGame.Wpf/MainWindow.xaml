<Window x:Class="FifteenGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:FifteenGame.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Игра 15"
        Height="620"
        Width="800"
        MinHeight="550"
        MinWidth="450"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Активный пользователь -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="5">

            <TextBlock Text="Игрок:"
                       FontSize="18"
                       Margin="5" />

            <TextBlock Text="{Binding UserName}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="5" />
        </StackPanel>

        <!-- Управление профилем и партией -->
        <WrapPanel Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="5">

            <Button Content="Сменить пользователя"
                    Padding="8,5"
                    Margin="3"
                    Click="SwitchUserButton_Click" />

            <Button Content="Удалить партию"
                    Padding="8,5"
                    Margin="3"
                    IsEnabled="{Binding HasGame}"
                    Click="DeleteGameButton_Click" />

            <Button Content="Удалить пользователя"
                    Padding="8,5"
                    Margin="3"
                    IsEnabled="{Binding HasUser}"
                    Click="DeleteUserButton_Click" />
        </WrapPanel>

        <!-- Счётчик ходов -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="5">

            <TextBlock Text="Количество ходов:"
                       FontSize="18"
                       Margin="5" />

            <TextBlock Text="{Binding MoveCount}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="5" />
        </StackPanel>

        <!-- Игровое поле -->
        <Grid Grid.Row="3"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="400"
              Height="400">

            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid Width="400" Height="400">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100" />
                                <RowDefinition Height="100" />
                                <RowDefinition Height="100" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Tag="{Binding Direction}"
                              MouseDown="Grid_MouseDown">

                            <Rectangle Margin="5"
                                       Stroke="Brown"
                                       StrokeThickness="3"
                                       RadiusX="10"
                                       RadiusY="10"
                                       Fill="LightBlue" />

                            <TextBlock Text="{Binding Text}"
                                       FontSize="36"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Grid.Row"
                                Value="{Binding Row}" />
                        <Setter Property="Grid.Column"
                                Value="{Binding Column}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>