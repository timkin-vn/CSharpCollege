<Window x:Class="FifteenGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FifteenGame.Wpf" 
        xmlns:viewmodels="clr-namespace:FifteenGame.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="2048" Height="620" Width="480" MinHeight="520" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#FDF1F4" KeyDown="Window_KeyDown" Focusable="True">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Мягкий стиль для пустых лунок на игровом поле -->
        <Style x:Key="EmptyCell" TargetType="Border">
            <Setter Property="Background" Value="#E6C5CC" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="6" />
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: Название и Блок со счетом -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Логотип -->
            <TextBlock Grid.Column="0"
                       Text="2048"
                       FontSize="56"
                       FontFamily="Trebuchet MS, Segoe UI, sans-serif"
                       FontWeight="Black"
                       Foreground="#C08497"
                       VerticalAlignment="Center" />

            <!-- Плашка счета -->
            <Border Grid.Column="1"
                    Background="#F4D3DB"
                    CornerRadius="14"
                    Padding="24,10"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="СЧЁТ"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#A47B88"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Score}"
                               FontSize="28"
                               FontWeight="Black"
                               Foreground="#7A5361"
                               HorizontalAlignment="Center"
                               Margin="0,-2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Игровое поле (Масштабируется при изменении окна) -->
        <Viewbox Grid.Row="1" Stretch="Uniform" VerticalAlignment="Top">
            <!-- Фон всего поля -->
            <Border Background="#F4D3DB"
                    CornerRadius="16"
                    Padding="8">

                <Grid>
                    <!-- Подложка из пустых ячеек (16 штук) -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100" />
                            <RowDefinition Height="100" />
                            <RowDefinition Height="100" />
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource EmptyCell}" />

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource EmptyCell}" />

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource EmptyCell}" />

                        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource EmptyCell}" />
                        <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource EmptyCell}" />
                    </Grid>

                    <!-- Коллекция активных плиток из вашей ViewModel -->
                    <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="100" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding TileBrush}"
                                        CornerRadius="12"
                                        Margin="6">
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="40"
                                               FontFamily="Trebuchet MS, Segoe UI, sans-serif"
                                               FontWeight="Bold"
                                               Foreground="{Binding TextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="{Binding Row}" />
                                <Setter Property="Grid.Column" Value="{Binding Column}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</Window>