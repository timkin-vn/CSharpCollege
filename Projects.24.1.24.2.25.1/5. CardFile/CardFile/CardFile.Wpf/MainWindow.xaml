<Window x:Class="CardFile.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:CardFile.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="520"
        Width="1100"
        MinHeight="400"
        MinWidth="800"
        Loaded="Window_Loaded"
        Initialized="Window_Initialized">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть..."
                          Click="FileOpenMenuItem_Click" />
                <MenuItem Header="_Сохранить"
                          Click="FileSaveMenuItem_Click" />
                <MenuItem Header="Со_хранить как..."
                          Click="FileSaveAsMenuItem_Click" />
                <Separator />
                <MenuItem Header="В_ыход"
                          Click="FileExitMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Cards}"
                      SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                      SelectionChanged="DataGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      Margin="5">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Марка и модель"
                                        Binding="{Binding CarName}"
                                        Width="*" />
                    <DataGridTextColumn Header="Год"
                                        Binding="{Binding Year}"
                                        Width="70" />
                    <DataGridTextColumn Header="Цвет"
                                        Binding="{Binding Color}"
                                        Width="100" />
                    <DataGridTextColumn Header="Пробег"
                                        Binding="{Binding MileageText}"
                                        Width="110" />
                    <DataGridTextColumn Header="Цена"
                                        Binding="{Binding PriceText}"
                                        Width="130" />
                    <DataGridTextColumn Header="Топливо"
                                        Binding="{Binding FuelType}"
                                        Width="100" />
                    <DataGridTextColumn Header="Объём двигателя"
                                        Binding="{Binding EngineVolumeText}"
                                        Width="120" />
                    <DataGridTextColumn Header="Коробка передач"
                                        Binding="{Binding TransmissionType}"
                                        Width="130" />
                    <DataGridTextColumn Header="Кондиционер"
                                        Binding="{Binding AirConditioningText}"
                                        Width="110" />
                    <DataGridTextColumn Header="Дата добавления"
                                        Binding="{Binding AddedDateText}"
                                        Width="120" />
                    <DataGridTextColumn Header="Дата продажи"
                                        Binding="{Binding SoldDateText}"
                                        Width="120" />
                    <DataGridTextColumn Header="VIN"
                                        Binding="{Binding Vin}"
                                        Width="180" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Создать"
                        Padding="10,5"
                        Margin="5"
                        Click="CreateButton_Click" />
                <Button Content="Правка"
                        IsEnabled="{Binding IsEditButtonEnabled}"
                        Padding="10,5"
                        Margin="5"
                        Click="EditButton_Click" />
                <Button Content="Удалить"
                        IsEnabled="{Binding IsDeleteButtonEnabled}"
                        Padding="10,5"
                        Margin="5"
                        Click="DeleteButton_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
