<Window x:Class="CardFile.Wpf.Views.CardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CardFile.Wpf.Views" xmlns:viewmodels="clr-namespace:CardFile.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Правка карточки героя" Height="360" Width="450" ResizeMode="NoResize">
    <Window.DataContext>
        <viewmodels:CardViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Герой:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Margin="5" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя в лоре:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LoreName}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Margin="5" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Основной атрибут:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
        <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" Text="{Binding PrimaryAttribute}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Margin="5">
            <ComboBoxItem Content="Сила" />
            <ComboBoxItem Content="Ловкость" />
            <ComboBoxItem Content="Интеллект" />
            <ComboBoxItem Content="Универсальный" />
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип атаки:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
        <ComboBox Grid.Row="3" Grid.Column="1" IsEditable="True" Text="{Binding AttackType}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Margin="5">
            <ComboBoxItem Content="Ближний бой" />
            <ComboBoxItem Content="Дальний бой" />
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Роль:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Role}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Margin="5" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата добавления:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
        <DatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding ReleaseDate}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Дата переработки:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
            <DatePicker SelectedDate="{Binding ReworkDate}" IsEnabled="{Binding IsReworkDateEnabled}" VerticalAlignment="Center" Margin="5" />

            <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsNotReworked}" Margin="5" Checked="IsNotReworkedCheckBox_Checked" Unchecked="IsNotReworkedCheckBox_Unchecked">
                <TextBlock Text="Без переработок" VerticalAlignment="Center" />
            </CheckBox>
        </StackPanel>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Винрейт, %:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding WinRate}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Margin="5" />

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Content="OK" Padding="5" Margin="5" Click="OkButton_Click" />

            <Button Content="Отмена" Padding="5" Margin="5" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
