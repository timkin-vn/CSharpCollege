<Window x:Class="CardFile.Wpf.Views.CardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Правка фильма" Height="400" Width="500" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Width="300" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Режиссёр:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Director}" VerticalAlignment="Center" Width="300" Margin="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Год выпуска:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReleaseYear}" VerticalAlignment="Center" Width="100" Margin="5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Жанр:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Genre}" VerticalAlignment="Center" Width="200" Margin="5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Длительность (мин):" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DurationMinutes}" VerticalAlignment="Center" Width="100" Margin="5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Рейтинг (1–10):" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Rating}" VerticalAlignment="Center" Width="50" Margin="5"/>

        <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="В наличии" IsChecked="{Binding IsAvailable}"
                  VerticalAlignment="Center" Margin="5"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="OK" Padding="10,5" Margin="5" Click="OkButton_Click"/>
            <Button Content="Отмена" Padding="10,5" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
