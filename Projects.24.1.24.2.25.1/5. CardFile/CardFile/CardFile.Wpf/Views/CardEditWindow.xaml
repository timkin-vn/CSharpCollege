<Window x:Class="CardFile.Wpf.Views.CardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:CardFile.Wpf.ViewModels"
        Title="Карточка автомобиля"
        Height="620"
        Width="500"
        MinHeight="500"
        MinWidth="450"
        ResizeMode="CanResize">

    <Window.DataContext>
        <viewmodels:CardViewModel />
    </Window.DataContext>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="5">
            <Button Content="OK"
                    Padding="15,5"
                    Margin="5"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="Отмена"
                    Padding="15,5"
                    Margin="5"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Марка:" Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Модель:" Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Год выпуска:" Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding Year, UpdateSourceTrigger=LostFocus}"
                         Margin="5" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Цвет:" Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5" />

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Пробег (км):" Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding Mileage, UpdateSourceTrigger=LostFocus}"
                         Margin="5" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="Цена:" Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="5" Grid.Column="1"
                         Text="{Binding Price, UpdateSourceTrigger=LostFocus}"
                         Margin="5" />

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="Тип топлива:" Margin="5"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Row="6" Grid.Column="1"
                          SelectedValue="{Binding FuelType}"
                          SelectedValuePath="Content"
                          Margin="5">
                    <ComboBoxItem Content="Бензин" />
                    <ComboBoxItem Content="Дизель" />
                    <ComboBoxItem Content="Электричество" />
                    <ComboBoxItem Content="Гибрид" />
                    <ComboBoxItem Content="Газ" />
                </ComboBox>

                <TextBlock Grid.Row="7" Grid.Column="0"
                           Text="Объём двигателя (л):" Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="7" Grid.Column="1"
                         Text="{Binding EngineVolume, UpdateSourceTrigger=LostFocus}"
                         Margin="5" />

                <TextBlock Grid.Row="8" Grid.Column="0"
                           Text="Коробка передач:" Margin="5"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Row="8" Grid.Column="1"
                          SelectedValue="{Binding TransmissionType}"
                          SelectedValuePath="Content"
                          Margin="5">
                    <ComboBoxItem Content="Механика" />
                    <ComboBoxItem Content="Автомат" />
                    <ComboBoxItem Content="Робот" />
                    <ComboBoxItem Content="Вариатор" />
                    <ComboBoxItem Content="Другая" />
                </ComboBox>

                <TextBlock Grid.Row="9" Grid.Column="0"
                           Text="Кондиционер:" Margin="5"
                           VerticalAlignment="Center" />
                <CheckBox Grid.Row="9" Grid.Column="1"
                          IsChecked="{Binding HasAirConditioning}"
                          Content="Есть"
                          VerticalAlignment="Center"
                          Margin="5" />

                <TextBlock Grid.Row="10" Grid.Column="0"
                           Text="Дата добавления:" Margin="5"
                           VerticalAlignment="Center" />
                <DatePicker Grid.Row="10" Grid.Column="1"
                            SelectedDate="{Binding AddedDate}"
                            Margin="5" />

                <TextBlock Grid.Row="11" Grid.Column="0"
                           Text="Дата продажи:" Margin="5"
                           VerticalAlignment="Center" />
                <DatePicker Grid.Row="11" Grid.Column="1"
                            SelectedDate="{Binding SoldDate}"
                            Margin="5" />

                <TextBlock Grid.Row="12" Grid.Column="0"
                           Text="VIN:" Margin="5"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="12" Grid.Column="1"
                         Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
