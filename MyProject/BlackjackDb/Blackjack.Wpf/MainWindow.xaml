<Window x:Class="Blackjack.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="620" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#2E8B57">

    <Window.Resources>
        <DataTemplate x:Key="CardTemplate">
            <Border Width="60" Height="90" Background="White" CornerRadius="5"
                    Margin="5" BorderBrush="Black" BorderThickness="1">
                <TextBlock Text="{Binding ShortName}"
                           Foreground="{Binding Color}"
                           FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HandPanel">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Игровой стол -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Message}"
                       FontSize="24" Foreground="White" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,10"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Дилер" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DealerScore, StringFormat='Очки: {0}'}"
                           Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,5"/>
                <ItemsControl ItemsSource="{Binding DealerHand}"
                              ItemsPanel="{StaticResource HandPanel}"
                              ItemTemplate="{StaticResource CardTemplate}"/>
            </StackPanel>

            <Rectangle Grid.Row="2" Height="2" Fill="White" Margin="0,10"/>

            <StackPanel Grid.Row="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PlayerScore, StringFormat='Очки: {0}'}"
                           Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,5"/>
                <ItemsControl ItemsSource="{Binding PlayerHand}"
                              ItemsPanel="{StaticResource HandPanel}"
                              ItemTemplate="{StaticResource CardTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Взять карту" Width="120" Height="40" Margin="10"
                        Command="{Binding HitCommand}" FontSize="14"/>
                <Button Content="Хватит" Width="120" Height="40" Margin="10"
                        Command="{Binding StandCommand}" FontSize="14"/>
                <Button Content="Новая игра" Width="120" Height="40" Margin="10"
                        Command="{Binding NewGameCommand}" FontSize="14" Background="LightGray"/>
            </StackPanel>
        </Grid>

        <!-- Статистика из базы данных -->
        <Border Grid.Column="1" Margin="15,0,0,0" Padding="10" Background="#226B43" CornerRadius="5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Статистика" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatsText}" Foreground="White" FontSize="14"
                           TextWrapping="Wrap" Margin="0,5,0,15"/>
                <TextBlock DockPanel.Dock="Top" Text="Последние игры" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <ListBox ItemsSource="{Binding History}" Margin="0,5,0,0" FontSize="13"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
