<Window x:Class="Blackjack.Wpf.Views.UserLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в игру 21" Height="180" Width="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="Имя игрока:" FontSize="14"/>
        <TextBox x:Name="NameTextBox" FontSize="14" Margin="0,5,0,15" MaxLength="50"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Войти" Width="90" Height="28" Margin="0,0,10,0" IsDefault="True" Click="LoginButton_Click"/>
            <Button Content="Отмена" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
