@using System.Linq
@using System.Web.Mvc
@model FifteenGame.Web.Models.GameViewModel

@{
    ViewBag.Title = "Крестики-Нолики";
}

<main>
    <div class="text-center mt-4 mb-2">
        <h2>Крестики-Нолики</h2>
    </div>

    <!-- Блок со счетом -->
    <div class="d-flex justify-content-center mb-3">
        <div class="scoreboard">
            <span class="score-player">Вы (X): @Model.PlayerScore</span>
            <span class="score-divider">|</span>
            <span class="score-computer">Компьютер (O): @Model.ComputerScore</span>
        </div>
    </div>

    <div class="text-center mb-4">
        <h3 class="text-primary">@Model.StatusText</h3>
    </div>

    <div class="d-flex justify-content-center mb-4">
        <div class="ttt-grid">
            @foreach (var cell in Model.Cells)
            {
                if (cell.State == FifteenGame.Business.Models.CellState.Empty && !Model.IsGameOver)
                {
                    <a href="@Url.Action("MakeMove", "Game", new { row = cell.Row, column = cell.Column })" class="ttt-cell ttt-empty"></a>
                }
                else
                {
                    <div class="@(cell.IsWinningCell ? "ttt-cell ttt-win" : "ttt-cell")">
                        @cell.Text
                    </div>
                }
            }
        </div>
    </div>

    <div class="text-center">
        <a href="@Url.Action("NewGame", "Game")" class="btn btn-success btn-lg px-5">Новая игра</a>
    </div>
</main>

<style>
    .scoreboard {
        background-color: #2C3E50;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 18px;
        font-weight: bold;
    }

    .score-divider {
        margin: 0 15px;
        color: #7f8c8d;
    }

    .score-player {
        color: #3498DB;
    }

    .score-computer {
        color: #E74C3C;
    }

    .ttt-grid {
        display: grid;
        grid-template-columns: repeat(3, 100px);
        grid-template-rows: repeat(3, 100px);
        gap: 5px;
        background-color: #2C3E50;
        padding: 5px;
        border-radius: 10px;
    }

    .ttt-cell {
        background-color: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        font-weight: bold;
        color: #2C3E50;
        text-decoration: none !important;
        transition: background-color 0.2s;
    }

    .ttt-empty:hover {
        background-color: #f0f0f0;
    }

    .ttt-win {
        background-color: #2ECC71 !important;
        color: white;
    }
</style>