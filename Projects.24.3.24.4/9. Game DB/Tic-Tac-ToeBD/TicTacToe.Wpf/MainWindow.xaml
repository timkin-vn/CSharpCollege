<Window x:Class="TicTacToe.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Крестики-Нолики" Height="300" Width="300">
    <UniformGrid Rows="3" Columns="3">
        <Button Content="{Binding Cells[0]}" Command="{Binding CellClickCommand}" CommandParameter="0"/>
        <Button Content="{Binding Cells[1]}" Command="{Binding CellClickCommand}" CommandParameter="1"/>
        <Button Content="{Binding Cells[2]}" Command="{Binding CellClickCommand}" CommandParameter="2"/>
        <Button Content="{Binding Cells[3]}" Command="{Binding CellClickCommand}" CommandParameter="3"/>
        <Button Content="{Binding Cells[4]}" Command="{Binding CellClickCommand}" CommandParameter="4"/>
        <Button Content="{Binding Cells[5]}" Command="{Binding CellClickCommand}" CommandParameter="5"/>
        <Button Content="{Binding Cells[6]}" Command="{Binding CellClickCommand}" CommandParameter="6"/>
        <Button Content="{Binding Cells[7]}" Command="{Binding CellClickCommand}" CommandParameter="7"/>
        <Button Content="{Binding Cells[8]}" Command="{Binding CellClickCommand}" CommandParameter="8"/>
    </UniformGrid>
</Window>