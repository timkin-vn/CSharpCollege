<Window x:Class="FifteenGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FifteenGame.Wpf" xmlns:viewmodels="clr-namespace:FifteenGame.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Найди пару" SizeToContent="Height" Width="800" MinWidth="450">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Количество ходов: " Margin="5" FontSize="18"/>
            <TextBlock Text="{Binding MoveCount}" Margin="5" FontSize="18"/>
            <TextBlock Text="Время: " Margin="15,5,5,5" FontSize="18"/>
            <TextBlock Text="{Binding Time}" Margin="5" FontSize="18" />
            <TextBlock Text="Рекорд: " Margin="15,5,5,5" FontSize="18" />
            <TextBlock Text="{Binding Record}" Margin="5" FontSize="18" />

        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="🎨 Цвета" Width="100" Height="35" Margin="5" Click="Colors_Click"/>
            <Button Content="🐾 Животные" Width="110" Height="35" Margin="5" Click="Animals_Click"/>
            <Button Content="🍎 Фрукты" Width="100" Height="35" Margin="5" Click="Fruits_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">

            <Button Content=" Легко" Width="100" Height="35" Margin="5" Click="Easy_Click"/>
            <Button Content=" Средне" Width="100" Height="35" Margin="5" Click="Medium_Click"/>
            <Button Content=" Сложно" Width="100" Height="35" Margin="5" Click="Hard_Click"/>
        </StackPanel>

        <ItemsControl Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="100" Height="100" MouseDown="Grid_MouseDown">
                        <Rectangle Margin="5" Stroke="DarkGray" StrokeThickness="2" RadiusX="10" RadiusY="10" Fill="{Binding CardColor}"/>
                        <TextBlock Text="{Binding CardContent}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
        <Button Grid.Row="5" Grid.Column="1" Content="Играть снова" Width="150" Height="40" Margin="10" FontSize="16" Click="PlayAgain_Click"/>
    </Grid>
</Window>
