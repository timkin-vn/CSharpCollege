<Window x:Class="CardFile.Wpf.Views.CardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CardFile.Wpf.Views" xmlns:viewmodels="clr-namespace:CardFile.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Карточка студента" Height="560" Width="720" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <viewmodels:CardViewModel />
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="190"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="0, 0, 10, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Фамилия:" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Имя:" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="Отчество:" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Text="Дата рождения:" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Text="Факультет:" VerticalAlignment="Center" Height="16" RenderTransformOrigin="0.5,1.101" />
            <TextBlock Grid.Row="5" Text="Группа:" VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Text="Зачетная книжка:" VerticalAlignment="Center" />
            <TextBlock Grid.Row="7" Text="Средний балл:" VerticalAlignment="Center" />
            <TextBlock Grid.Row="8" Text="Форма обучения:" VerticalAlignment="Center" />
            <TextBlock Grid.Row="9" Text="Дата выпуска / отчисления:" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" Margin="0, 0, 15, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="51,7,40,0" />
            <TextBox Grid.Row="1" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="39,9,20,0" />
            <TextBox Grid.Row="2" Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="59,6,30,0" />
            <DatePicker Grid.Row="3" SelectedDate="{Binding BirthDate}" Width="150" HorizontalAlignment="Left" Margin="99,8,0,0" />

            <ComboBox Grid.Row="4" Text="{Binding Faculty}" IsEditable="True" VerticalContentAlignment="Center" Margin="59,5,34,5">
                <ComboBoxItem Content="Информационные технологии" />
                <ComboBoxItem Content="Экономика и управление" />
                <ComboBoxItem Content="Радиотехника" />
                <ComboBoxItem Content="Дизайн и медиа" />
                <ComboBoxItem Content="Гуманитарный" />
            </ComboBox>

            <ComboBox Grid.Row="5" Text="{Binding GroupNumber}" IsEditable="True" VerticalContentAlignment="Center" Margin="59,5,35,5">
                <ComboBoxItem Content="ИС-11" />
                <ComboBoxItem Content="ИС-31" />
                <ComboBoxItem Content="ЭК-22" />
                <ComboBoxItem Content="ПО-41" />
                <ComboBoxItem Content="РТ-32" />
                <ComboBoxItem Content="ГД-11" />
            </ComboBox>

            <TextBox Grid.Row="6" Text="{Binding RecordBookNumber, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="81,6,61,4" />
            <TextBox Grid.Row="7" Text="{Binding AverageScore, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="66,5,46,5" RenderTransformOrigin="0.332,0.611" />

            <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding IsBudget}" Content="Обучение на бюджете" VerticalAlignment="Center" />

            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="StudyingCheckBox" IsChecked="{Binding IsStudying}" Content="Учится сейчас" VerticalAlignment="Center" Margin="0,0,12,0" Click="StudyingCheckBox_Click" />
                <DatePicker x:Name="ExpulsionDatePicker" SelectedDate="{Binding ExpulsionDate}" Width="135" Height="28" ToolTip="Дата отчисления" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Grid.Column="2" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Background="#f8fafc" Padding="10" VerticalAlignment="Top" Margin="0,83,0,0">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="140" Height="165" Background="#e2e8f0" BorderBrush="#94a3b8" BorderThickness="1" Margin="0,0,0,10">
                    <Image Source="{Binding PhotoPath}" Stretch="UniformToFill" />
                </Border>
                <Button Content="Выбрать фото..." Padding="8,4" Margin="0,0,0,6" Click="SelectPhotoButton_Click" />
                <Button Content="Удалить фото" Padding="8,2" Background="Transparent" BorderThickness="0" Foreground="#64748b" Click="ClearPhotoButton_Click" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="95" Height="30" Margin="5,0" IsDefault="True" Click="OkButton_Click" />
            <Button Content="Отмена" Width="95" Height="30" Margin="5,0" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
