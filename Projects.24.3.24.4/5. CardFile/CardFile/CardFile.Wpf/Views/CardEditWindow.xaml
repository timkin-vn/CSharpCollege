<Window x:Class="CardFile.Wpf.Views.CardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:CardFile.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Правка автомобиля" Height="430" Width="500" ResizeMode="NoResize">
    <Window.DataContext>
        <viewmodels:CardViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

<TextBlock Grid.Row="0" Grid.Column="0" Text="Марка:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Brand}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="220" Margin="5" />

<TextBlock Grid.Row="1" Grid.Column="0" Text="Модель:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Model}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="220" Margin="5" />

<TextBlock Grid.Row="2" Grid.Column="0" Text="Госномер:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LicensePlate}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="220" Margin="5" />

<TextBlock Grid.Row="3" Grid.Column="0" Text="Дата выпуска:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding ManufactureDate}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<TextBlock Grid.Row="4" Grid.Column="0" Text="Цвет:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Color}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="220" Margin="5" />

<TextBlock Grid.Row="5" Grid.Column="0" Text="Владелец:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Owner}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="220" Margin="5" />

<TextBlock Grid.Row="6" Grid.Column="0" Text="Дата постановки на учёт:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<DatePicker Grid.Row="6" Grid.Column="1" SelectedDate="{Binding RegistrationDate}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<TextBlock Grid.Row="7" Grid.Column="0" Text="Дата снятия с учёта:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
    <DatePicker SelectedDate="{Binding DeregistrationDate}" IsEnabled="{Binding IsDeregistrationDateEnabled}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />
    <CheckBox IsChecked="{Binding IsRegisteredNow}" VerticalAlignment="Center" Margin="5" Checked="IsWorkingTillNowCheckBox_Checked" Unchecked="IsWorkingTillNowCheckBox_Unchecked">
        <TextBlock Text="Стоит на учёте" VerticalAlignment="Center" />
    </CheckBox>
</StackPanel>

<TextBlock Grid.Row="8" Grid.Column="0" Text="Стоимость:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

<TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Price}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="220" Margin="5" />

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Content="OK" Padding="5" Margin="5" Click="OkButton_Click" />
            <Button Content="Отмена" Padding="5" Margin="5" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
